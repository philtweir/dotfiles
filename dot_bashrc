cd() {
  if [[ $# -eq 0 ]]; then
    builtin pushd "$HOME" > /dev/null
  elif [[ "$1" == "-" && -n "$2" ]]; then
    builtin pushd +"$2" > /dev/null
  else
    builtin pushd "$@" > /dev/null
  fi
}

_fzf_dirstack_widget() {
  local dir
  dir=$(dirs -v | tail -n +2 | fzf --height=10 --reverse | awk '{print $2}' | sed "s|~|$HOME|")
  if [[ -n "$dir" ]]; then
    # Insert the chosen path at the cursor position
    READLINE_LINE="${READLINE_LINE:0:$READLINE_POINT}${dir}${READLINE_LINE:$READLINE_POINT}"
    READLINE_POINT=$(( READLINE_POINT + ${#dir} ))
  fi
}
bind -x '"\C-g": _fzf_dirstack_widget'
