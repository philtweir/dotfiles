# Include generic shellrc.
source "$HOME/.shellrc"

try_source /usr/share/doc/pkgfile/command-not-found.bash

# If not running interactively, don't do anything
[ -z "$PS1" ] && return

shopt -s checkwinsize
shopt -s histappend
HISTCONTROL=ignoredups:ignorespace
HISTSIZE=1000
HISTFILESIZE=2000



# Shortened path function (like zsh)
__short_pwd() {
    local p="${PWD/#$HOME/\~}"
    [[ "$p" == "~" || "$p" == "/" ]] && echo "$p" && return

    local base=$(basename "$p")
    local dir=$(dirname "$p")

    [[ "$dir" == "/" ]] && echo "/${base}" && return
    [[ "$dir" == "~" ]] && echo "~/${base}" && return

    local short_dir=$(echo "${dir}/" | sed 's:\([^/]\)[^/]*/:\1/:g')
    short_dir="${short_dir%/}"

    echo "${short_dir}/${base}"
}

# Git branch for prompt (blue "git", white ":", green/red branch)
# Now handled by blesh in ~/.blerc, but keep fallback for non-blesh shells
__update_git_ps1() {
    local branch=$(git symbolic-ref --short HEAD 2>/dev/null)
    if [[ -n "$branch" ]]; then
        # Attached HEAD - green branch
        GIT_PS1_SEGMENT=$' \001\e[34m\002git\001\e[m\002:\001\e[32m\002'"$branch"$'\001\e[m\002'
    else
        # Detached HEAD - red commit
        local commit=$(git rev-parse --short HEAD 2>/dev/null)
        if [[ -n "$commit" ]]; then
            GIT_PS1_SEGMENT=$' \001\e[34m\002git\001\e[m\002:\001\e[31m\002'"$commit"$'\001\e[m\002'
        else
            GIT_PS1_SEGMENT=""
        fi
    fi
}

# Virtualenv for prompt (disable default, handle ourselves)
VIRTUAL_ENV_DISABLE_PROMPT=1
__venv_ps1() {
    [[ -n "$VIRTUAL_ENV" ]] && echo "($(basename "$VIRTUAL_ENV")) "
}

# Vi mode indicator for blesh: ❯❯❯ for insert, ❮❮❮ for command
__vi_mode_indicator() {
    if [[ $_ble_decode_keymap == vi_imap ]]; then
        printf '\e[31m❯\e[33m❯\e[32m❯\e[m '
    else
        printf '\e[32m❮\e[33m❮\e[31m❮\e[m '
    fi
}

# Vi mode
set -o vi

# Mode indication handled by blesh (see ~/.blerc)
# Disabled bash readline mode indicators to prevent conflicts
#bind 'set show-mode-in-prompt on'
#bind 'set vi-ins-mode-string \1\e[5 q\e[31m\2❯\1\e[33m\2❯\1\e[32m\2❯\1\e[m\2 '
#bind 'set vi-cmd-mode-string \1\e[1 q\e[32m\2❮\1\e[33m\2❮\1\e[31m\2❮\1\e[m\2 '

# Prompt setup - default for vanilla bash, overridden by blesh in ~/.blerc
PS1=' '
# xterm title
case "$TERM" in
	xterm*|rxvt*) PS1+='\[\e]0;\u@\h: \w\a\]' ;;
	*) ;;
esac

# Prompt: (venv) hostname| ~/s/path git:branch ❯
# (mode indicator ❯❯❯/❮❮❮ is prepended by readline if enabled)
PS1+='\[\e[m\]$(__venv_ps1)'
PS1+='\[\e[32m\]\h\[\e[m\]| '
PS1+='\[\e[36m\]$(__short_pwd)\[\e[m\]'
PS1+='${GIT_PS1_SEGMENT}'
if [ $UID -eq 0 ]; then
	PS1+='\[\e[31m\] #\[\e[m\] '
else
	PS1+=' \[\e[33m\]❯\[\e[m\] '
fi

# Update git branch before each prompt
PROMPT_COMMAND="__update_git_ps1${PROMPT_COMMAND:+;$PROMPT_COMMAND}"


function grt() {
  echo $(git rev-parse --show-toplevel)
}
function G() {
  cd $(grt)
}

# enable programmable completion features (you don't need to enable
